{
  // Cloudflare Worker + static assets for lifelegallysingle.com
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifelegallysingle-micro-oct26",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // STEP 1 (now): test on the free workers.dev address.
  "workers_dev": true,
  "preview_urls": true
  // STEP 2 (after deleting the old @ and www A records in DNS):
  // add a comma after "preview_urls": true above, then uncomment:
  // "routes": [
  //   { "pattern": "lifelegallysingle.com", "custom_domain": true },
  //   { "pattern": "www.lifelegallysingle.com", "custom_domain": true }
  // ]
}
